# Copy to .env.local. Never commit real values.
# Production (Railway): set these as variables on the `web` service, with the
# production values noted below. For the seed scripts run from a laptop against production,
# put the same values in .env.production.local (git-ignored) and pass --env production.

# Supabase
# Production: the hosted project's API URL and anon key. NEXT_PUBLIC_* are inlined at build
# time, so set them before the first Railway build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# Qloo (hackathon)
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=                     # server only, your own event key
QLOO_MODE=mock                    # live | mock | replay. Production: live (replay if the key stops working)

# LLM (OpenAI Responses API)
LLM_PROVIDER=openai               # openai (the only provider today)
OPENAI_API_KEY=                   # server only
OPENAI_MODEL=gpt-6.1-sol          # empty = gpt-6.1-sol
CONCIERGE_MODE=live                # live | replay (recorded fixture, e2e)
COMPARE_MODE=live                  # live | replay (recorded fixture, e2e)

# Weather (Open-Meteo, no key)
WEATHER_MODE=live                 # live | mock

# App
# Public URL for QR codes, printed cards, guest links and the magic-link redirect.
# Production: APP_URL=https://hostbrain.larinera.com. A localhost value uses the request's origin.
APP_URL=http://localhost:3000
DEMO_MODE=true                    # production: true for the hackathon (demo-host login button)
REPO_URL=                         # public GitHub repo, linked in the landing footer
DEMO_HOST_EMAIL=demo-host@larinera.com   # created by scripts/seed-demo.ts

# Railway sets PORT itself (`next start` reads it). The cleanup cron service only needs
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and QLOO_MODE.
